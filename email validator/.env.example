# Port for the web server
PORT=3000

# Deep SMTP mailbox + catch-all checks.
# Requires OUTBOUND PORT 25, which free hosts block.
# Leave false unless you are on OVH / RackNerd / Contabo / Render paid /
# Vultr or DigitalOcean with an unblock ticket approved.
SMTP_CHECK=false

# Max addresses per bulk request
BULK_LIMIT=100

# Requests per IP per minute
RATE_MAX=60

# EHLO hostname. On a real server this MUST match the PTR record of your
# sending IP, or Yahoo and AOL reject you with 5.7.25 before RCPT.
SMTP_HELO=localhost

# Random probe addresses used to detect catch-all domains (0-10).
# More is more reliable but risks tripping anti-harvesting limits.
SMTP_CANARIES=2

# Inline retry delay for greylisting, in ms. Real greylisting wants 30-60s,
# which is too slow to hold an HTTP request open; anything still deferred is
# reported honestly as "greylisted" rather than guessed at.
SMTP_GREYLIST_DELAY=5000

# Domain registration age via RDAP. Set false to skip the lookup entirely.
RDAP_CHECK=true
RDAP_TIMEOUT=6000

# Bulk queue
BULK_CONCURRENCY=8
PER_DOMAIN_GAP_MS=350
JOB_TTL_MS=3600000

# Set to true only when running behind a reverse proxy (nginx, Render, Railway...)
TRUST_PROXY=false
